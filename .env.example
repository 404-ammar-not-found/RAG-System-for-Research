# One key is enough. Free Gemini key: https://aistudio.google.com/apikey
# Anthropic has no embedding API, so an ANTHROPIC_API_KEY on its own cannot
# ingest — pair it with a Gemini or OpenAI key for the vectors.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional. Which provider answers questions: gemini | anthropic | openai.
# Empty picks the first key set, in that order.
LLM_PROVIDER=

# Optional. Where vectors come from: gemini | openai | local.
# `local` runs all-MiniLM-L6-v2 on your machine through onnxruntime — no key,
# no quota, ~79MB downloaded once. Set it when a hosted daily cap runs out.
# Empty means the chat provider embeds for itself, falling back to local.
EMBED_PROVIDER=

# Optional model overrides. Empty uses the provider's defaults from
# src/pipeline/deps.py — set these if a provider retires a model id.
TEXT_LLM_MODEL=
GRAPH_LLM_MODEL=
EMBED_MODEL=
GRAPH_EMBED_MODEL=

# Knowledge graph. 6380 avoids a plain redis-server already on 6379.
FALKORDB_HOST=localhost
FALKORDB_PORT=6380

# Optional: your email, for the OpenAlex/Crossref polite pool.
OPENALEX_MAILTO=
